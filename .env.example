# ============================================================
# .env.example
# 本文件仅保留键名，作为 .env 的模板。
# 使用方法：cp .env.example .env，然后在 .env 中填入真实值。
# ⚠️ 请勿在本文件中写入任何真实密钥/密码，且必须将 .env 加入 .gitignore。
# ============================================================

# ---------- API 配置 ----------
API_KEY=
BASE_URL=
MODEL=

# ---------- AI 迭代配置 ----------
# 最大迭代次数，防止工具调用死循环
MAX_ITERATIONS=

# ---------- 邮箱配置（SMTP） ----------
MAIL_HOST=
MAIL_PORT=
MAIL_SECURE=
MAIL_USER=
MAIL_PASS=
MAIL_FROM=

# ---------- Embedding 配置 ----------
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=
EMBEDDING_DIM=

# ---------- MySQL 数据库配置 ----------
# DB_PASSWORD 同时作为 docker-compose-mysql.yml 中
# MYSQL_ROOT_PASSWORD 与 MYSQL_PASSWORD 的来源，请使用强密码。
DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_NAME=

# ---------- Milvus 配置 ----------
MILVUS_ADDRESS=
EBOOK_COLLECTION_NAME=

# ---------- 高德地图 API ----------
AMAP_MAPS_API_KEY=

# ---------- Bocha Web Search API（备用） ----------
BOCHA_API_KEY=

# ---------- Tavily Web Search API ----------
# 申请地址：https://tavily.com
TAVILY_API_KEY=

# ---------- 腾讯云 TTS（语音合成） ----------
# 申请地址：https://console.cloud.tencent.com/cam/capi
SECRET_ID=
SECRET_KEY=
APP_ID=

# ---------- Rerank 配置 ----------
RERANK_MODEL=
RERANK_TOP_N=
